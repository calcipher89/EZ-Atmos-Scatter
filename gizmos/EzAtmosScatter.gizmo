 }
set N436d800 [stack 0]
 Write {
  channels all
  file "\[if \{\[value parent.bake_file] != \"\"\} \{value parent.bake_file\} \{set d \[if \{\"\[python \{__import__('os').environ.get('EZATMOS_CACHE_DIR') or ''\}]\" != \"\"\} \{set e \"\[python \{__import__('os').environ.get('EZATMOS_CACHE_DIR') or ''\}]\"\} \{set e \[file dirname \[value root.name]]/ezatmos_cache\}]/\[file rootname \[file tail \[value root.name]]]/\[value parent.name]/\[file rootname \[file tail \[value root.name]]]_\[value parent.name].####.exr\}]"
  file_type exr
  first_part rgba
  create_directories true
  in_colorspace scene_linear
  out_colorspace scene_linear
  ocioColorspace scene_linear
  display default
  view sRGB
  name BakeWrite
  xpos 200
  ypos 780
 }
 Read {
  inputs 0
  file "\[if \{\[value parent.bake_file] != \"\"\} \{value parent.bake_file\} \{set d \[if \{\"\[python \{__import__('os').environ.get('EZATMOS_CACHE_DIR') or ''\}]\" != \"\"\} \{set e \"\[python \{__import__('os').environ.get('EZATMOS_CACHE_DIR') or ''\}]\"\} \{set e \[file dirname \[value root.name]]/ezatmos_cache\}]/\[file rootname \[file tail \[value root.name]]]/\[value parent.name]/\[file rootname \[file tail \[value root.name]]]_\[value parent.name].####.exr\}]"
  first {{parent.baked_first}}
  last {{parent.baked_last}}
  origfirst {{parent.baked_first}}
  origlast {{parent.baked_last}}
  on_error black
  in_colorspace scene_linear
  out_colorspace scene_linear
  name BakeRead
  xpos 200
  ypos 840
 }
push $N436d800
 Switch {
  inputs 2
  which {{"parent.use_baked && parent.bake_valid"}}
  name UseBake
  xpos 0
  ypos 840
 }
 Output {
  name Output1
  xpos 0
  ypos 920
 }
end_group
