 addUserKnob {7 sun_strength l "sun strength" t "Multiplies the sun's brightness." R 0 4}
 sun_strength 1
 addUserKnob {7 sun_boost l "sun boost" t "Only used when the HDRI's sun is clipped (JPEGs, LDR captures). The sun is then sized from the sky brightness; this scales it." R 0 4}
