 BlinkScript {
  inputs 3
  recompileCount 2
  KernelDescription "3 \"AtmosScatter\" iterate pixelWise 68f8a1e790cd7bb95b524fc060282b8efe8cbaaf00885df912f5633ae951bc4e 4 \"src\" Read Random \"light\" Read Random \"lut\" Read Random \"dst\" Write Point 25 \"output\" Int 1 AAAAAA== \"depth_haze\" Int 1 AAAAAA== \"sun_from_hdri\" Int 1 AAAAAA== \"light_from_hdri\" Int 1 AAAAAA== \"sun_direction\" Float 3 AAAAAAAAAD8AAIC/AAAAAA== \"sun_color\" Float 3 AACAPwAAgD8AAIA/AAAAAA== \"sun_intensity\" Float 1 AACgQQ== \"sun_strength\" Float 1 AACAPw== \"sun_boost\" Float 1 AACAPw== \"sky_light\" Float 1 AAAAAA== \"clear_sky_ratio\" Float 1 AABcQg== \"camera_altitude_km\" Float 1 bxKDOg== \"max_distance_km\" Float 1 AAAAAA== \"haze_distance_km\" Float 1 AACgQA== \"longitude_offset_deg\" Float 1 AAAAAA== \"rayleigh_density\" Float 1 AACAPw== \"mie_density\" Float 1 AACAPw== \"rayleigh_coefficients\" Float 3 w2SqOxQ/Rjyze/I8AAAAAA== \"mie_coefficient\" Float 1 MQisPA== \"rayleigh_scale_height_km\" Float 1 AAAIQQ== \"mie_scale_height_km\" Float 1 mpmZPw== \"mie_g\" Float 1 XI9CPw== \"planet_radius_km\" Float 1 AMDGRQ== \"atmosphere_thickness_km\" Float 1 AABwQg== \"view_samples\" Int 1 EAAAAA== 25 \"output\" 1 1 Default \"depthHaze\" 1 1 Default \"sunFromHdri\" 1 1 Default \"lightFromHdri\" 1 1 Default \"sunDirection\" 3 1 Default \"sunColor\" 3 1 Default \"sunIntensity\" 1 1 Default \"sunStrength\" 1 1 Default \"sunBoost\" 1 1 Default \"skyLight\" 1 1 Default \"clearSkyRatio\" 1 1 Default \"cameraAltitude\" 1 1 Default \"maxDistance\" 1 1 Default \"hazeDistance\" 1 1 Default \"longitudeOffset\" 1 1 Default \"rayleighDensity\" 1 1 Default \"mieDensity\" 1 1 Default \"rayleighCoefficients\" 3 1 Default \"mieCoefficient\" 1 1 Default \"rayleighScaleHeight\" 1 1 Default \"mieScaleHeight\" 1 1 Default \"mieG\" 1 1 Default \"planetRadius\" 1 1 Default \"atmosphereThickness\" 1 1 Default \"viewSamples\" 1 1 Default 7 \"pi\" Float 1 1 AAAAAA== \"horizonLength\" Float 1 1 AAAAAA== \"manualSunDir\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"atmosphereRadius\" Float 1 1 AAAAAA== \"betaR\" Float 3 1 AAAAAAAAAAAAAAAAAAAAAA== \"betaMScatter\" Float 1 1 AAAAAA== \"betaMExtinction\" Float 1 1 AAAAAA=="
  kernelSource "// EZ Atmos Scatter: single-scattering atmosphere for lat-long images.\n//\n// Every pixel of the lat-long input is treated as a view direction from a camera\n// sitting just above the planet surface. The kernel raymarches that view ray through\n// a spherical atmosphere (Rayleigh + Mie, exponential density falloff) and, at every\n// sample, marches a second ray towards the sun to get the light that reaches it.\n// Based on O'Neil, \"Accurate Atmospheric Scattering\" (GPU Gems 2, ch. 16) and the\n// Nishita model it builds on.\n//\n// Lighting can come from the HDRI itself: the `light` input is the 4x1 image written by\n// EzAtmosLight.blink (sun direction, sun irradiance, average sky radiance). The sun the\n// HDRI shows has already been dimmed by the atmosphere, so its irradiance is divided by\n// the sun's transmittance at the camera to get the light arriving at the top of the\n// atmosphere. Sky light adds an isotropic ambient term that stands in for multiple\n// scattering.\n//\n// The optical depth towards the sun comes from the `lut` input, the table written by\n// EzAtmosTransmittanceLUT.blink, instead of a second raymarch at every sample.\n// Transmittance and sky light need no sun at all, so those outputs skip it.\n//\n// All distances are in kilometres. Heights are carried separately from positions so\n// that near-horizon rays stay stable in 32-bit float.\n//\n// Lat-long convention: x = longitude (centre column looks down -Z), y = latitude\n// (bottom row = straight down, top row = straight up), +Y is up.\n//\n// output: 0 = inscatter (Rayleigh + Mie + ambient), 1 = Rayleigh only, 2 = Mie only,\n//         3 = view transmittance, 4 = preview comp (src * transmittance + inscatter),\n//         5 = ambient (sky light) only, 8 = haze colour, 10 and 11 = its sunlit and sky-lit\n//         parts, 9 = haze transmittance at\n//         hazeDistance. With depthHaze on, outputs 0-5 describe haze around the camera\n//         out to hazeDistance instead of the atmosphere (see the depth haze block).\n\n\nkernel AtmosScatter : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> src;\n  Image<eRead, eAccessRandom, eEdgeClamped> light;\n  Image<eRead, eAccessRandom, eEdgeClamped> lut;\n  Image<eWrite> dst;\n\nparam:\n  int output;\n  int depthHaze;\n  int sunFromHdri;\n  int lightFromHdri;\n  float3 sunDirection;\n  float3 sunColor;\n  float sunIntensity;\n  float sunStrength;\n  float sunBoost;\n  float skyLight;\n  float clearSkyRatio;\n  float cameraAltitude;\n  float maxDistance;\n  float hazeDistance;\n  float longitudeOffset;\n  float rayleighDensity;\n  float mieDensity;\n  float3 rayleighCoefficients;\n  float mieCoefficient;\n  float rayleighScaleHeight;\n  float mieScaleHeight;\n  float mieG;\n  float planetRadius;\n  float atmosphereThickness;\n  int viewSamples;\n\nlocal:\n  float pi;\n  float horizonLength;\n  float3 manualSunDir;\n  float atmosphereRadius;\n  float3 betaR;\n  float betaMScatter;\n  float betaMExtinction;\n\n  void define()\n  \{\n    defineParam(output, \"output\", 0);\n    defineParam(depthHaze, \"depth_haze\", 0);\n    defineParam(sunFromHdri, \"sun_from_hdri\", 0);\n    defineParam(lightFromHdri, \"light_from_hdri\", 0);\n    defineParam(sunDirection, \"sun_direction\", float3(0.0f, 0.5f, -1.0f));\n    defineParam(sunColor, \"sun_color\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(sunIntensity, \"sun_intensity\", 20.0f);\n    defineParam(sunStrength, \"sun_strength\", 1.0f);\n    defineParam(sunBoost, \"sun_boost\", 1.0f);\n    defineParam(skyLight, \"sky_light\", 0.0f);\n    defineParam(clearSkyRatio, \"clear_sky_ratio\", 55.0f);\n    defineParam(cameraAltitude, \"camera_altitude_km\", 0.001f);\n    defineParam(maxDistance, \"max_distance_km\", 0.0f);\n    defineParam(hazeDistance, \"haze_distance_km\", 5.0f);\n    defineParam(longitudeOffset, \"longitude_offset_deg\", 0.0f);\n    defineParam(rayleighDensity, \"rayleigh_density\", 1.0f);\n    defineParam(mieDensity, \"mie_density\", 1.0f);\n    defineParam(rayleighCoefficients, \"rayleigh_coefficients\", float3(0.0052f, 0.0121f, 0.0296f));\n    defineParam(mieCoefficient, \"mie_coefficient\", 0.021f);\n    defineParam(rayleighScaleHeight, \"rayleigh_scale_height_km\", 8.5f);\n    defineParam(mieScaleHeight, \"mie_scale_height_km\", 1.2f);\n    defineParam(mieG, \"mie_g\", 0.76f);\n    defineParam(planetRadius, \"planet_radius_km\", 6360.0f);\n    defineParam(atmosphereThickness, \"atmosphere_thickness_km\", 60.0f);\n    defineParam(viewSamples, \"view_samples\", 16);\n  \}\n\n  void init()\n  \{\n    pi = 3.14159265358979f;\n    manualSunDir = length(sunDirection) > 0.0f ? normalize(sunDirection) : float3(0.0f, 1.0f, 0.0f);\n    atmosphereRadius = planetRadius + atmosphereThickness;\n    horizonLength = sqrt(atmosphereRadius * atmosphereRadius - planetRadius * planetRadius);\n    betaR = rayleighCoefficients * rayleighDensity;\n    betaMScatter = mieCoefficient * mieDensity;\n    betaMExtinction = betaMScatter / 0.9f;\n  \}\n\n  float3 exp3(float3 v)\n  \{\n    return float3(exp(v.x), exp(v.y), exp(v.z));\n  \}\n\n  float luminance(float3 c)\n  \{\n    return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z;\n  \}\n\n  // Far intersection of a ray starting inside a sphere of radius r.\n  // c = |o|^2 - r^2 is passed in precomputed so callers can build it from heights.\n  float exitDistance(float b, float c)\n  \{\n    float disc = b * b - c;\n    return -b + sqrt(max(disc, 0.0f));\n  \}\n\n  // Distance to the ground along the ray, or -1 if the ray misses the planet.\n  float groundDistance(float b, float c)\n  \{\n    if (b > 0.0f)\n      return -1.0f;\n    float disc = b * b - c;\n    if (disc < 0.0f)\n      return -1.0f;\n    return -b - sqrt(disc);\n  \}\n\n  float phaseRayleigh(float mu)\n  \{\n    return 3.0f / (16.0f * pi) * (1.0f + mu * mu);\n  \}\n\n  // Cornette-Shanks approximation of the Mie phase function.\n  float phaseMie(float mu)\n  \{\n    float g2 = mieG * mieG;\n    float denom = pow(max(1.0f + g2 - 2.0f * mieG * mu, 1e-6f), 1.5f);\n    return 3.0f / (8.0f * pi) * ((1.0f - g2) * (1.0f + mu * mu)) / ((2.0f + g2) * denom);\n  \}\n\n  // Optical depth (Rayleigh in x, Mie in y) from point p towards the sun, read from the\n  // table EzAtmosTransmittanceLUT.blink precomputes. Returns -1 in x if the planet\n  // blocks the sun.\n  float2 sunOpticalDepth(float3 p, float h, float3 sunDir)\n  \{\n    h = clamp(h, 0.0f, atmosphereThickness);\n    float r = h + planetRadius;\n    float b = dot(p, sunDir) * r / length(p);\n    float cGround = h * (r + planetRadius);\n    if (groundDistance(b, cGround) > 0.0f)\n      return float2(-1.0f, 0.0f);\n\n    // Inverse of the mapping in EzAtmosTransmittanceLUT.blink.\n    float rho = sqrt(max(r * r - planetRadius * planetRadius, 0.0f));\n    float d = exitDistance(b, (r - atmosphereRadius) * (r + atmosphereRadius));\n    float dMin = atmosphereRadius - r;\n    float dMax = rho + horizonLength;\n    float u = (d - dMin) / max(dMax - dMin, 1e-6f);\n    float v = rho / horizonLength;\n    float x = lut.bounds.x1 + u * lut.bounds.width() - 0.5f;\n    float y = lut.bounds.y1 + v * lut.bounds.height() - 0.5f;\n    float4 od = bilinear(lut, x, y);\n    return float2(od.x, od.y);\n  \}\n\n  float4 lightPixel(int i)\n  \{\n    return light(light.bounds.x1 + i, light.bounds.y1);\n  \}\n\n  void process(int2 pos)\n  \{\n    float h0 = max(cameraAltitude, 0.0f);\n    float r0 = planetRadius + h0;\n    float3 origin = float3(0.0f, r0, 0.0f);\n\n    // Light measured from the HDRI (see EzAtmosLight.blink).\n    float4 hdriSun = lightPixel(0);\n    float4 hdriSunIrradiance = lightPixel(1);\n    float4 hdriSky = lightPixel(2);\n    float3 skyAverage = float3(hdriSky.x, hdriSky.y, hdriSky.z);\n\n    float3 sunDir = manualSunDir;\n    float3 measuredDir = float3(hdriSun.x, hdriSun.y, hdriSun.z);\n    if (sunFromHdri != 0 && length(measuredDir) > 0.0f)\n      sunDir = normalize(measuredDir);\n\n    // Transmittance and sky light depend on the view ray alone.\n    bool needSun = output != 3 && output != 5 && output != 9;\n\n    float3 sun = sunColor * sunIntensity * sunStrength;\n    if (needSun && lightFromHdri != 0) \{\n      if (hdriSunIrradiance.w > 0.5f) \{\n        // Clipped sun (LDR or low dynamic range capture): its energy is lost, so size it\n        // from the sky instead. clearSkyRatio is sun irradiance over average sky radiance\n        // for this model at default settings.\n        sun = sunColor * (clearSkyRatio * luminance(skyAverage) * sunBoost * sunStrength);\n      \} else \{\n        // Undo the atmosphere between the camera and the sun to get top-of-atmosphere light.\n        float2 od = sunOpticalDepth(origin, h0, sunDir);\n        float3 tSun = float3(1.0f);\n        if (od.x >= 0.0f)\n          tSun = exp3(-(betaR * od.x + betaMExtinction * od.y));\n        tSun = float3(max(tSun.x, 0.02f), max(tSun.y, 0.02f), max(tSun.z, 0.02f));\n        float3 measured = float3(hdriSunIrradiance.x, hdriSunIrradiance.y, hdriSunIrradiance.z);\n        sun = sunColor * (measured / tSun) * sunStrength;\n      \}\n    \}\n\n    float width = src.bounds.width();\n    float height = src.bounds.height();\n    float u = (pos.x - src.bounds.x1 + 0.5f) / width;\n    float v = (pos.y - src.bounds.y1 + 0.5f) / height;\n    float lon = (u - 0.5f) * 2.0f * pi + longitudeOffset * pi / 180.0f;\n    float lat = (v - 0.5f) * pi;\n    float3 dir = float3(sin(lon) * cos(lat), sin(lat), -cos(lon) * cos(lat));\n\n    // Depth haze: the air and haze around the camera, for hazing a plate with its depth.\n    // Scattering and extinction coefficients at camera height, per km.\n    float3 localR = betaR * exp(-h0 / rayleighScaleHeight);\n    float localMScatter = betaMScatter * exp(-h0 / mieScaleHeight);\n    float localMExtinction = betaMExtinction * exp(-h0 / mieScaleHeight);\n    if (output >= 8 || depthHaze != 0) \{\n      // Haze colour: what infinitely deep haze looks like in this direction. Sunlight\n      // reaching the camera height, scattered towards the viewer, plus sky light scattered\n      // evenly, over everything the haze absorbs or scatters away:\n      //   hazeColor = (sun * Tsun * scatter(mu) + sky * scatter) / extinction\n      // Plate hazing then is plate * T + hazeColor * (1 - T).\n      float2 od = sunOpticalDepth(origin, h0, sunDir);\n      float3 tSun = float3(0.0f);\n      if (od.x >= 0.0f)\n        tSun = exp3(-(betaR * od.x + betaMExtinction * od.y));\n      float mu = dot(dir, sunDir);\n      float3 extinction = localR + float3(localMExtinction);\n      float3 sunPart = sun * tSun / extinction;\n      float3 rayleighHaze = sunPart * localR * phaseRayleigh(mu);\n      float3 mieHaze = sunPart * (localMScatter * phaseMie(mu));\n      float3 ambientHaze = skyAverage * skyLight * (localR + float3(localMScatter)) / extinction;\n\n      // Transmittance over hazeDistance along this direction, with each kind of particle\n      // thinning out exponentially with height (flat-ground approximation):\n      //   tau = beta(h0) * H * (1 - exp(-d * cos / H)) / cos,  cos = dir.y\n      float c = dir.y;\n      float d = hazeDistance;\n      float fR = d;\n      float fM = d;\n      if (fabs(c) > 1e-4f) \{\n        fR = rayleighScaleHeight * (1.0f - exp(-d * c / rayleighScaleHeight)) / c;\n        fM = mieScaleHeight * (1.0f - exp(-d * c / mieScaleHeight)) / c;\n      \}\n      float3 tHaze = exp3(-(localR * fR + float3(localMExtinction * fM)));\n      float3 veil = float3(1.0f) - tHaze;\n\n      // Depth haze passes: the same layers as the atmosphere passes, but for haze around\n      // the camera out to hazeDistance, with no ground and no horizon line.\n      float3 hazeResult = (rayleighHaze + mieHaze + ambientHaze) * veil;\n      float hazeAlpha = 1.0f;\n      if (output == 1) \{\n        hazeResult = rayleighHaze * veil;\n      \} else if (output == 2) \{\n        hazeResult = mieHaze * veil;\n      \} else if (output == 3 || output == 9) \{\n        hazeResult = tHaze;\n      \} else if (output == 4) \{\n        float4 s = src(pos.x, pos.y);\n        hazeResult = float3(s.x, s.y, s.z) * tHaze + hazeResult;\n        hazeAlpha = s.w;\n      \} else if (output == 5) \{\n        hazeResult = ambientHaze * veil;\n      \} else if (output == 8) \{\n        hazeResult = rayleighHaze + mieHaze + ambientHaze;\n      \} else if (output == 10) \{\n        hazeResult = rayleighHaze + mieHaze;\n      \} else if (output == 11) \{\n        hazeResult = ambientHaze;\n      \}\n      dst() = float4(hazeResult.x, hazeResult.y, hazeResult.z, hazeAlpha);\n      return;\n    \}\n\n    float b = dot(origin, dir);\n\n    // March to the top of the atmosphere, or to the ground for downward rays.\n    float tMax = exitDistance(b, (r0 - atmosphereRadius) * (r0 + atmosphereRadius));\n    float tGround = groundDistance(b, h0 * (r0 + planetRadius));\n    if (tGround > 0.0f)\n      tMax = tGround;\n    if (maxDistance > 0.0f)\n      tMax = min(tMax, maxDistance);\n\n    float segment = tMax / viewSamples;\n    float odR = 0.0f;\n    float odM = 0.0f;\n    float3 sumR = float3(0.0f);\n    float3 sumM = float3(0.0f);\n    for (int i = 0; i < viewSamples; i++) \{\n      float3 p = origin + dir * (segment * (i + 0.5f));\n      float h = length(p) - planetRadius;\n      float densR = exp(-h / rayleighScaleHeight) * segment;\n      float densM = exp(-h / mieScaleHeight) * segment;\n      odR += densR;\n      odM += densM;\n\n      if (!needSun)\n        continue;\n      float2 sunOd = sunOpticalDepth(p, h, sunDir);\n      if (sunOd.x >= 0.0f) \{\n        float3 tau = betaR * (odR + sunOd.x) + betaMExtinction * (odM + sunOd.y);\n        float3 attenuation = exp3(-tau);\n        sumR += attenuation * densR;\n        sumM += attenuation * densM;\n      \}\n    \}\n\n    float mu = dot(dir, sunDir);\n    float3 rayleigh = sun * sumR * betaR * phaseRayleigh(mu);\n    float3 mie = sun * sumM * betaMScatter * phaseMie(mu);\n    float3 transmittance = exp3(-(betaR * odR + betaMExtinction * odM));\n    // Sky light scattered into the view ray, treated as isotropic.\n    float3 ambient = skyAverage * skyLight * (float3(1.0f) - transmittance);\n\n    float3 result = rayleigh + mie + ambient;\n    float alpha = 1.0f;\n    if (output == 1) \{\n      result = rayleigh;\n    \} else if (output == 2) \{\n      result = mie;\n    \} else if (output == 3) \{\n      result = transmittance;\n    \} else if (output == 4) \{\n      float4 s = src(pos.x, pos.y);\n      result = float3(s.x, s.y, s.z) * transmittance + rayleigh + mie + ambient;\n      alpha = s.w;\n    \} else if (output == 5) \{\n      result = ambient;\n    \}\n    dst() = float4(result.x, result.y, result.z, alpha);\n  \}\n\};\n"
  rebuild ""
  AtmosScatter_output {{2}}
  AtmosScatter_depth_haze {{parent.passes}}
  AtmosScatter_sun_from_hdri {{parent.sun_from==0}}
  AtmosScatter_light_from_hdri {{"parent.light_from_hdri && !parent.self_lit"}}
  AtmosScatter_sun_direction {{"parent.sun_from==1 && \[exists parent.input1] ? (\[python -execlocal \{n = nuke.thisGroup().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 3) if n is not None else 0\}]) : parent.sun_direction.x"} {"parent.sun_from==1 && \[exists parent.input1] ? (\[python -execlocal \{n = nuke.thisGroup().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 7) if n is not None else 0\}]) : parent.sun_direction.y"} {"parent.sun_from==1 && \[exists parent.input1] ? (\[python -execlocal \{n = nuke.thisGroup().input(1)\nwhile n is not None and not n.knob('world_matrix'):\n    n = n.input(0) if n.inputs() else None\nret = n\['world_matrix'].getValueAt(nuke.frame(), 11) if n is not None else 0\}]) : parent.sun_direction.z"}}
  AtmosScatter_sun_color {{parent.sun_color.r} {parent.sun_color.g} {parent.sun_color.b}}
  AtmosScatter_sun_intensity {{parent.manual_sun_brightness}}
  AtmosScatter_sun_strength {{parent.sun_strength}}
  AtmosScatter_sun_boost {{parent.sun_boost}}
  AtmosScatter_sky_light {{parent.sky_light}}
  AtmosScatter_clear_sky_ratio {{parent.clear_sky_ratio}}
  AtmosScatter_camera_altitude_km {{"parent.camera_height / 1000"}}
  AtmosScatter_max_distance_km {{parent.max_distance}}
  AtmosScatter_haze_distance_km {{parent.haze_distance}}
  AtmosScatter_longitude_offset_deg {{parent.hdri_rotation}}
  AtmosScatter_rayleigh_density {{parent.sky_amount}}
  AtmosScatter_mie_density {{parent.haze_amount}}
  AtmosScatter_rayleigh_coefficients {{parent.rayleigh_coefficients.x} {parent.rayleigh_coefficients.y} {parent.rayleigh_coefficients.z}}
  AtmosScatter_mie_coefficient {{parent.mie_coefficient}}
  AtmosScatter_rayleigh_scale_height_km {{parent.rayleigh_scale_height}}
  AtmosScatter_mie_scale_height_km {{parent.haze_height}}
  AtmosScatter_mie_g {{"clamp(1 - 0.24 * parent.haze_glow_size, 0, 0.99)"}}
  AtmosScatter_planet_radius_km {{parent.planet_radius}}
  AtmosScatter_atmosphere_thickness_km {{parent.atmosphere_thickness}}
  AtmosScatter_view_samples {{"parent.quality==0 ? 8 : parent.quality==1 ? 16 : 32"}}
  rebuild_finalise ""
  name Scatter_mie
  xpos -150
  ypos -100
 }
set N4106000 [stack 0]
 Crop {
  box {{0} {0} {input.width} {"input.height / 2"}}
  crop false
  name mie_ground_cut
  xpos -150
  ypos 30
 }
 Reformat {
  type "to box"
  box_width {{HDRISource.width}}
  box_height {{HDRISource.height}}
  box_fixed true
  resize distort
  name mie_ground_up
  xpos -150
  ypos 60
 }
