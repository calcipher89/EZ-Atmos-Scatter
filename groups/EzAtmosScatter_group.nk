 BlinkScript {
  recompileCount 2
  KernelDescription "3 \"EzAtmosTransmittanceLUT\" iterate pixelWise 7b9e665df90b9b69e3888fd3ba97f65f2a96400aabc8ddd21a158f8f110f94bb 2 \"ref\" Read Point \"dst\" Write Point 5 \"planet_radius_km\" Float 1 AMDGRQ== \"atmosphere_thickness_km\" Float 1 AABwQg== \"rayleigh_scale_height_km\" Float 1 AAAIQQ== \"mie_scale_height_km\" Float 1 mpmZPw== \"samples\" Int 1 QAAAAA== 5 \"planetRadius\" 1 1 Default \"atmosphereThickness\" 1 1 Default \"rayleighScaleHeight\" 1 1 Default \"mieScaleHeight\" 1 1 Default \"samples\" 1 1 Default 2 \"atmosphereRadius\" Float 1 1 AAAAAA== \"horizonLength\" Float 1 1 AAAAAA=="
  kernelSource "// EzAtmosTransmittanceLUT: optical depth from any point in the atmosphere to its top.\n//\n// Precomputes what AtmosScatter.blink would otherwise march towards the sun at every\n// sample of every view ray. Feed it any image of the LUT size (256x64 works well); it\n// writes Rayleigh optical depth in red and Mie optical depth in green, in km of\n// sea-level-density air.\n//\n// Parameterisation from Bruneton, \"Precomputed Atmospheric Scattering\" (2017 version):\n//   v = rho / H              rho = sqrt(r^2 - Rg^2), H = sqrt(Rt^2 - Rg^2)\n//   u = (d - dMin) / (dMax - dMin)\n// where d is the distance to the top of the atmosphere along the ray. Only rays that do\n// not hit the ground are stored; callers test for the ground themselves.\n// AtmosScatter.blink holds the matching lookup (lutUV); keep the two in step.\n\nkernel EzAtmosTransmittanceLUT : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> ref;\n  Image<eWrite> dst;\n\nparam:\n  float planetRadius;\n  float atmosphereThickness;\n  float rayleighScaleHeight;\n  float mieScaleHeight;\n  int samples;\n\nlocal:\n  float atmosphereRadius;\n  float horizonLength;\n\n  void define()\n  \{\n    defineParam(planetRadius, \"planet_radius_km\", 6360.0f);\n    defineParam(atmosphereThickness, \"atmosphere_thickness_km\", 60.0f);\n    defineParam(rayleighScaleHeight, \"rayleigh_scale_height_km\", 8.5f);\n    defineParam(mieScaleHeight, \"mie_scale_height_km\", 1.2f);\n    defineParam(samples, \"samples\", 64);\n  \}\n\n  void init()\n  \{\n    atmosphereRadius = planetRadius + atmosphereThickness;\n    horizonLength = sqrt(atmosphereRadius * atmosphereRadius - planetRadius * planetRadius);\n  \}\n\n  void process(int2 pos)\n  \{\n    float u = (pos.x - ref.bounds.x1 + 0.5f) / ref.bounds.width();\n    float v = (pos.y - ref.bounds.y1 + 0.5f) / ref.bounds.height();\n\n    float rho = v * horizonLength;\n    float r = sqrt(rho * rho + planetRadius * planetRadius);\n    float dMin = atmosphereRadius - r;\n    float dMax = rho + horizonLength;\n    float d = dMin + u * (dMax - dMin);\n    float mu = d <= 0.0f ? 1.0f : (horizonLength * horizonLength - rho * rho - d * d) / (2.0f * r * d);\n    mu = clamp(mu, -1.0f, 1.0f);\n\n    float3 origin = float3(0.0f, r, 0.0f);\n    float3 dir = float3(sqrt(max(1.0f - mu * mu, 0.0f)), mu, 0.0f);\n    float segment = d / samples;\n    float odR = 0.0f;\n    float odM = 0.0f;\n    for (int i = 0; i < samples; i++) \{\n      float3 q = origin + dir * (segment * (i + 0.5f));\n      float h = max(length(q) - planetRadius, 0.0f);\n      odR += exp(-h / rayleighScaleHeight) * segment;\n      odM += exp(-h / mieScaleHeight) * segment;\n    \}\n    dst() = float4(odR, odM, 0.0f, 1.0f);\n  \}\n\};\n"
  rebuild ""
  EzAtmosTransmittanceLUT_planet_radius_km {{parent.planet_radius}}
  EzAtmosTransmittanceLUT_atmosphere_thickness_km {{parent.atmosphere_thickness}}
  EzAtmosTransmittanceLUT_rayleigh_scale_height_km {{parent.rayleigh_scale_height}}
  EzAtmosTransmittanceLUT_mie_scale_height_km {{parent.haze_height}}
  rebuild_finalise ""
  name TransmittanceLUT
  xpos 450
  ypos -180
 }
