// EZ Atmos Scatter: single-scattering atmosphere for lat-long images.
//
// Every pixel of the lat-long input is treated as a view direction from a camera
// sitting just above the planet surface. The kernel raymarches that view ray through
// a spherical atmosphere (Rayleigh + Mie, exponential density falloff) and, at every
// sample, marches a second ray towards the sun to get the light that reaches it.
// Based on O'Neil, "Accurate Atmospheric Scattering" (GPU Gems 2, ch. 16) and the
// Nishita model it builds on.
//
// Lighting can come from the HDRI itself: the `light` input is the 4x1 image written by
// EzAtmosLight.blink (sun direction, sun irradiance, average sky radiance). The sun the
// HDRI shows has already been dimmed by the atmosphere, so its irradiance is divided by
// the sun's transmittance at the camera to get the light arriving at the top of the
// atmosphere. Sky light adds an isotropic ambient term that stands in for multiple
// scattering.
//
// The optical depth towards the sun comes from the `lut` input, the table written by
// EzAtmosTransmittanceLUT.blink, instead of a second raymarch at every sample.
// Transmittance and sky light need no sun at all, so those outputs skip it.
//
// All distances are in kilometres. Heights are carried separately from positions so
// that near-horizon rays stay stable in 32-bit float.
//
// Lat-long convention: x = longitude (centre column looks down -Z), y = latitude
// (bottom row = straight down, top row = straight up), +Y is up.
//
// output: 0 = inscatter (Rayleigh + Mie + ambient), 1 = Rayleigh only, 2 = Mie only,
//         3 = view transmittance, 4 = preview comp (src * transmittance + inscatter),
//         5 = ambient (sky light) only, 8 = haze colour, 10 and 11 = its sunlit and sky-lit
//         parts, 9 = haze transmittance at
//         hazeDistance. With depthHaze on, outputs 0-5 describe haze around the camera
//         out to hazeDistance instead of the atmosphere (see the depth haze block).


kernel AtmosScatter : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessRandom, eEdgeClamped> src;
  Image<eRead, eAccessRandom, eEdgeClamped> light;
  Image<eRead, eAccessRandom, eEdgeClamped> lut;
  Image<eWrite> dst;

param:
  int output;
  int depthHaze;
  int sunFromHdri;
  int lightFromHdri;
  float3 sunDirection;
  float3 sunColor;
  float sunIntensity;
  float sunStrength;
  float sunBoost;
  float skyLight;
  float clearSkyRatio;
  float cameraAltitude;
  float maxDistance;
  float hazeDistance;
  float longitudeOffset;
  float rayleighDensity;
  float mieDensity;
  float3 rayleighCoefficients;
  float mieCoefficient;
  float rayleighScaleHeight;
  float mieScaleHeight;
  float mieG;
  float planetRadius;
  float atmosphereThickness;
  int viewSamples;

local:
  float pi;
  float horizonLength;
  float3 manualSunDir;
  float atmosphereRadius;
  float3 betaR;
  float betaMScatter;
  float betaMExtinction;

  void define()
  {
    defineParam(output, "output", 0);
    defineParam(depthHaze, "depth_haze", 0);
    defineParam(sunFromHdri, "sun_from_hdri", 0);
    defineParam(lightFromHdri, "light_from_hdri", 0);
    defineParam(sunDirection, "sun_direction", float3(0.0f, 0.5f, -1.0f));
    defineParam(sunColor, "sun_color", float3(1.0f, 1.0f, 1.0f));
    defineParam(sunIntensity, "sun_intensity", 20.0f);
    defineParam(sunStrength, "sun_strength", 1.0f);
    defineParam(sunBoost, "sun_boost", 1.0f);
    defineParam(skyLight, "sky_light", 0.0f);
    defineParam(clearSkyRatio, "clear_sky_ratio", 55.0f);
    defineParam(cameraAltitude, "camera_altitude_km", 0.001f);
    defineParam(maxDistance, "max_distance_km", 0.0f);
    defineParam(hazeDistance, "haze_distance_km", 5.0f);
    defineParam(longitudeOffset, "longitude_offset_deg", 0.0f);
    defineParam(rayleighDensity, "rayleigh_density", 1.0f);
    defineParam(mieDensity, "mie_density", 1.0f);
    defineParam(rayleighCoefficients, "rayleigh_coefficients", float3(0.0052f, 0.0121f, 0.0296f));
    defineParam(mieCoefficient, "mie_coefficient", 0.021f);
    defineParam(rayleighScaleHeight, "rayleigh_scale_height_km", 8.5f);
    defineParam(mieScaleHeight, "mie_scale_height_km", 1.2f);
    defineParam(mieG, "mie_g", 0.76f);
    defineParam(planetRadius, "planet_radius_km", 6360.0f);
    defineParam(atmosphereThickness, "atmosphere_thickness_km", 60.0f);
    defineParam(viewSamples, "view_samples", 16);
  }

  void init()
  {
    pi = 3.14159265358979f;
    manualSunDir = length(sunDirection) > 0.0f ? normalize(sunDirection) : float3(0.0f, 1.0f, 0.0f);
    atmosphereRadius = planetRadius + atmosphereThickness;
    horizonLength = sqrt(atmosphereRadius * atmosphereRadius - planetRadius * planetRadius);
    betaR = rayleighCoefficients * rayleighDensity;
    betaMScatter = mieCoefficient * mieDensity;
    betaMExtinction = betaMScatter / 0.9f;
  }

  float3 exp3(float3 v)
  {
    return float3(exp(v.x), exp(v.y), exp(v.z));
  }

  float luminance(float3 c)
  {
    return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z;
  }

  // Far intersection of a ray starting inside a sphere of radius r.
  // c = |o|^2 - r^2 is passed in precomputed so callers can build it from heights.
  float exitDistance(float b, float c)
  {
    float disc = b * b - c;
    return -b + sqrt(max(disc, 0.0f));
  }

  // Distance to the ground along the ray, or -1 if the ray misses the planet.
  float groundDistance(float b, float c)
  {
    if (b > 0.0f)
      return -1.0f;
    float disc = b * b - c;
    if (disc < 0.0f)
      return -1.0f;
    return -b - sqrt(disc);
  }

  float phaseRayleigh(float mu)
  {
    return 3.0f / (16.0f * pi) * (1.0f + mu * mu);
  }

  // Cornette-Shanks approximation of the Mie phase function.
  float phaseMie(float mu)
  {
    float g2 = mieG * mieG;
    float denom = pow(max(1.0f + g2 - 2.0f * mieG * mu, 1e-6f), 1.5f);
    return 3.0f / (8.0f * pi) * ((1.0f - g2) * (1.0f + mu * mu)) / ((2.0f + g2) * denom);
  }

  // Optical depth (Rayleigh in x, Mie in y) from point p towards the sun, read from the
  // table EzAtmosTransmittanceLUT.blink precomputes. Returns -1 in x if the planet
  // blocks the sun.
  float2 sunOpticalDepth(float3 p, float h, float3 sunDir)
  {
    h = clamp(h, 0.0f, atmosphereThickness);
    float r = h + planetRadius;
    float b = dot(p, sunDir) * r / length(p);
    float cGround = h * (r + planetRadius);
    if (groundDistance(b, cGround) > 0.0f)
      return float2(-1.0f, 0.0f);

    // Inverse of the mapping in EzAtmosTransmittanceLUT.blink.
    float rho = sqrt(max(r * r - planetRadius * planetRadius, 0.0f));
    float d = exitDistance(b, (r - atmosphereRadius) * (r + atmosphereRadius));
    float dMin = atmosphereRadius - r;
    float dMax = rho + horizonLength;
    float u = (d - dMin) / max(dMax - dMin, 1e-6f);
    float v = rho / horizonLength;
    float x = lut.bounds.x1 + u * lut.bounds.width() - 0.5f;
    float y = lut.bounds.y1 + v * lut.bounds.height() - 0.5f;
    float4 od = bilinear(lut, x, y);
    return float2(od.x, od.y);
  }

  float4 lightPixel(int i)
  {
    return light(light.bounds.x1 + i, light.bounds.y1);
  }

  void process(int2 pos)
  {
    float h0 = max(cameraAltitude, 0.0f);
    float r0 = planetRadius + h0;
    float3 origin = float3(0.0f, r0, 0.0f);

    // Light measured from the HDRI (see EzAtmosLight.blink).
    float4 hdriSun = lightPixel(0);
    float4 hdriSunIrradiance = lightPixel(1);
    float4 hdriSky = lightPixel(2);
    float3 skyAverage = float3(hdriSky.x, hdriSky.y, hdriSky.z);

    float3 sunDir = manualSunDir;
    float3 measuredDir = float3(hdriSun.x, hdriSun.y, hdriSun.z);
    if (sunFromHdri != 0 && length(measuredDir) > 0.0f)
      sunDir = normalize(measuredDir);

    // Transmittance and sky light depend on the view ray alone.
    bool needSun = output != 3 && output != 5 && output != 9;

    float3 sun = sunColor * sunIntensity * sunStrength;
    if (needSun && lightFromHdri != 0) {
      if (hdriSunIrradiance.w > 0.5f) {
        // Clipped sun (LDR or low dynamic range capture): its energy is lost, so size it
        // from the sky instead. clearSkyRatio is sun irradiance over average sky radiance
        // for this model at default settings.
        sun = sunColor * (clearSkyRatio * luminance(skyAverage) * sunBoost * sunStrength);
      } else {
        // Undo the atmosphere between the camera and the sun to get top-of-atmosphere light.
        float2 od = sunOpticalDepth(origin, h0, sunDir);
        float3 tSun = float3(1.0f);
        if (od.x >= 0.0f)
          tSun = exp3(-(betaR * od.x + betaMExtinction * od.y));
        tSun = float3(max(tSun.x, 0.02f), max(tSun.y, 0.02f), max(tSun.z, 0.02f));
        float3 measured = float3(hdriSunIrradiance.x, hdriSunIrradiance.y, hdriSunIrradiance.z);
        sun = sunColor * (measured / tSun) * sunStrength;
      }
    }

    float width = src.bounds.width();
    float height = src.bounds.height();
    float u = (pos.x - src.bounds.x1 + 0.5f) / width;
    float v = (pos.y - src.bounds.y1 + 0.5f) / height;
    float lon = (u - 0.5f) * 2.0f * pi + longitudeOffset * pi / 180.0f;
    float lat = (v - 0.5f) * pi;
    float3 dir = float3(sin(lon) * cos(lat), sin(lat), -cos(lon) * cos(lat));

    // Depth haze: the air and haze around the camera, for hazing a plate with its depth.
    // Scattering and extinction coefficients at camera height, per km.
    float3 localR = betaR * exp(-h0 / rayleighScaleHeight);
    float localMScatter = betaMScatter * exp(-h0 / mieScaleHeight);
    float localMExtinction = betaMExtinction * exp(-h0 / mieScaleHeight);
    if (output >= 8 || depthHaze != 0) {
      // Haze colour: what infinitely deep haze looks like in this direction. Sunlight
      // reaching the camera height, scattered towards the viewer, plus sky light scattered
      // evenly, over everything the haze absorbs or scatters away:
      //   hazeColor = (sun * Tsun * scatter(mu) + sky * scatter) / extinction
      // Plate hazing then is plate * T + hazeColor * (1 - T).
      float2 od = sunOpticalDepth(origin, h0, sunDir);
      float3 tSun = float3(0.0f);
      if (od.x >= 0.0f)
        tSun = exp3(-(betaR * od.x + betaMExtinction * od.y));
      float mu = dot(dir, sunDir);
      // Kept above zero: with no air and no haze (both amounts 0) there is nothing to scatter,
      // and 0 / 0 would turn every pass into NaN.
      float3 extinction = max(localR + float3(localMExtinction), float3(1e-12f));
      float3 sunPart = sun * tSun / extinction;
      float3 rayleighHaze = sunPart * localR * phaseRayleigh(mu);
      float3 mieHaze = sunPart * (localMScatter * phaseMie(mu));
      float3 ambientHaze = skyAverage * skyLight * (localR + float3(localMScatter)) / extinction;

      // Transmittance over hazeDistance along this direction, with each kind of particle
      // thinning out exponentially with height (flat-ground approximation):
      //   tau = beta(h0) * H * (1 - exp(-d * cos / H)) / cos,  cos = dir.y
      float c = dir.y;
      float d = hazeDistance;
      float fR = d;
      float fM = d;
      if (fabs(c) > 1e-4f) {
        fR = rayleighScaleHeight * (1.0f - exp(-d * c / rayleighScaleHeight)) / c;
        fM = mieScaleHeight * (1.0f - exp(-d * c / mieScaleHeight)) / c;
      }
      float3 tHaze = exp3(-(localR * fR + float3(localMExtinction * fM)));
      float3 veil = float3(1.0f) - tHaze;

      // Depth haze passes: the same layers as the atmosphere passes, but for haze around
      // the camera out to hazeDistance, with no ground and no horizon line.
      float3 hazeResult = (rayleighHaze + mieHaze + ambientHaze) * veil;
      float hazeAlpha = 1.0f;
      if (output == 1) {
        hazeResult = rayleighHaze * veil;
      } else if (output == 2) {
        hazeResult = mieHaze * veil;
      } else if (output == 3 || output == 9) {
        hazeResult = tHaze;
      } else if (output == 4) {
        float4 s = src(pos.x, pos.y);
        hazeResult = float3(s.x, s.y, s.z) * tHaze + hazeResult;
        hazeAlpha = s.w;
      } else if (output == 5) {
        hazeResult = ambientHaze * veil;
      } else if (output == 8) {
        hazeResult = rayleighHaze + mieHaze + ambientHaze;
      } else if (output == 10) {
        hazeResult = rayleighHaze + mieHaze;
      } else if (output == 11) {
        hazeResult = ambientHaze;
      }
      dst() = float4(hazeResult.x, hazeResult.y, hazeResult.z, hazeAlpha);
      return;
    }

    float b = dot(origin, dir);

    // March to the top of the atmosphere, or to the ground for downward rays.
    float tMax = exitDistance(b, (r0 - atmosphereRadius) * (r0 + atmosphereRadius));
    float tGround = groundDistance(b, h0 * (r0 + planetRadius));
    if (tGround > 0.0f)
      tMax = tGround;
    if (maxDistance > 0.0f)
      tMax = min(tMax, maxDistance);

    float segment = tMax / viewSamples;
    float odR = 0.0f;
    float odM = 0.0f;
    float3 sumR = float3(0.0f);
    float3 sumM = float3(0.0f);
    for (int i = 0; i < viewSamples; i++) {
      float3 p = origin + dir * (segment * (i + 0.5f));
      float h = length(p) - planetRadius;
      float densR = exp(-h / rayleighScaleHeight) * segment;
      float densM = exp(-h / mieScaleHeight) * segment;
      odR += densR;
      odM += densM;

      if (!needSun)
        continue;
      float2 sunOd = sunOpticalDepth(p, h, sunDir);
      if (sunOd.x >= 0.0f) {
        float3 tau = betaR * (odR + sunOd.x) + betaMExtinction * (odM + sunOd.y);
        float3 attenuation = exp3(-tau);
        sumR += attenuation * densR;
        sumM += attenuation * densM;
      }
    }

    float mu = dot(dir, sunDir);
    float3 rayleigh = sun * sumR * betaR * phaseRayleigh(mu);
    float3 mie = sun * sumM * betaMScatter * phaseMie(mu);
    float3 transmittance = exp3(-(betaR * odR + betaMExtinction * odM));
    // Sky light scattered into the view ray, treated as isotropic.
    float3 ambient = skyAverage * skyLight * (float3(1.0f) - transmittance);

    float3 result = rayleigh + mie + ambient;
    float alpha = 1.0f;
    if (output == 1) {
      result = rayleigh;
    } else if (output == 2) {
      result = mie;
    } else if (output == 3) {
      result = transmittance;
    } else if (output == 4) {
      float4 s = src(pos.x, pos.y);
      result = float3(s.x, s.y, s.z) * transmittance + rayleigh + mie + ambient;
      alpha = s.w;
    } else if (output == 5) {
      result = ambient;
    }
    dst() = float4(result.x, result.y, result.z, alpha);
  }
};
